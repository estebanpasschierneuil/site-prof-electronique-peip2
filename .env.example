# ——— Base de données ———
# Postgres de production (Supabase, Neon, RDS…). Sans cette variable, l'application
# démarre sur une base PGlite embarquée, en mode démonstration.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/affut

# Dossier de la base embarquée (développement, démo). `memory` pour une base volatile.
# PGLITE_DIR=.data/pglite

# Applique les migrations au démarrage. Par défaut : oui en embarqué, non avec DATABASE_URL
# (préférer `npm run db:migrate` dans la chaîne de déploiement).
# AUTO_MIGRATE=false

# Crée et tient à jour l'organisation de démonstration. Par défaut : actif sans DATABASE_URL.
# DEMO_MODE=false

# ——— Application ———
# Adresse publique, utilisée pour les liens d'invitation et les retours OAuth.
APP_URL=http://localhost:3000

# Clé de chiffrement des jetons des plateformes : 32 octets en base64.
# Obligatoire en production. Génération : openssl rand -base64 32
# APP_ENCRYPTION_KEY=

# Secret de la tâche planifiée de synchronisation (POST /api/cron/sync).
# CRON_SECRET=

# ——— Plateformes connectées en OAuth ———
# Créez une application développeur chez chaque plateforme, puis renseignez ses identifiants.
# Adresse de retour à déclarer : $APP_URL/api/integrations/<plateforme>/callback
# (plateforme = strava, polar, wahoo, whoop ou oura). Une plateforme sans identifiants
# reste simplement masquée du lien d'invitation des athlètes.

# Strava : https://www.strava.com/settings/api
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Polar Flow (AccessLink) : https://admin.polaraccesslink.com
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=

# Wahoo : https://developers.wahooligan.com
# WAHOO_CLIENT_ID=
# WAHOO_CLIENT_SECRET=

# WHOOP : https://developer-dashboard.whoop.com
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=

# Oura : https://cloud.ouraring.com/oauth/applications
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=

# intervals.icu et l'import de fichiers (FIT, TCX, GPX) ne demandent aucune configuration.
